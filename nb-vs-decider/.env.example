# Copy to .env (never commit). Read via python-dotenv in scripts/common.py.

# Pinned Decider checkpoint (Hugging Face model id + exact revision SHA).
DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21
DECIDER_REVISION=2b52a6235c1b8306bbfa30b00b9d4b74b63a39f5

# Base model the adapter was trained on, and its pinned revision.
DECIDER_BASE_MODEL=Qwen/Qwen3.5-2B-Base
DECIDER_BASE_REVISION=b1485b2fa6dfa1287294f269f5fb618e03d52d7c

# Host GPU index given to the pipeline container (docker compose device_ids).
DECIDER_GPU=0

# CPU cores the pipeline container is pinned to (docker cpuset syntax).
PIPELINE_CPUSET=0-5

# Python logging level.
LOG_LEVEL=INFO
